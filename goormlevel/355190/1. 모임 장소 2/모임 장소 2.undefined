# -*- coding: utf-8 -*-
# UTF-8 encoding when using korean
n = int(input())

x_list=[]
y_list=[]

for i in range(1, n+1):
	x, y = map(int, input().split())
	x_list.append(x)
	y_list.append(y)
	# print(x_list, y_list)

x_list.sort()
y_list.sort()
mid = (n - 1) // 2

tx = x_list[mid]
ty = y_list[mid]
print(f"{tx} {ty}")
	

	
	
